{
  "name": "@ngo/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsup",
    "lint": "eslint src scripts tests",
    "type-check": "tsc --noEmit",
    "migrate": "tsx scripts/migrate.ts",
    "gen:types": "npx -y supabase@2 gen types typescript --local --schema public > src/types.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "postgres": "^3.4.4",
    "tsup": "^8.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
