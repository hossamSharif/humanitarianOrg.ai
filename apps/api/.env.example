# @ngo/api environment. Copy to .env.local and fill from `npx supabase start` output.
# Never commit real values.

# Supabase project URL and keys
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
# Service-role key: Auth admin calls only (invites, app_metadata.tenant_id). Never sent to the web.
SUPABASE_SERVICE_ROLE_KEY=
# Used to verify access tokens (jose, HS256).
SUPABASE_JWT_SECRET=

# Postgres for transactional commands (postgres driver, prepare:false). In cloud, use the SESSION
# pooler (port 5432): the API is a long-running server, and the transaction pooler (6543) hung on
# pipelined queries in testing. The direct db.<ref> host is IPv6-only. Locally: port 54322.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

PORT=4000
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000
