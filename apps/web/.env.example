# @ngo/web environment. Copy to .env.local and fill from `npx supabase start` output.
# Only public (anon) values belong here; never put the service-role key in the web app.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
